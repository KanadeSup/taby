{
  "env": {
    "__DEV__": "true"
  },
  "watch": [
    "new-tab",
    "lib",
    "api",
    "hooks",
    "assets",
    "models",
    "components",
    "vite.config.base.ts",
    "vite.config.chrome.ts",
    "manifest.json",
    "manifest.dev.json"
  ],
  "ext": "tsx,css,html,ts,json",
  "ignore": [
    "src/**/*.spec.ts"
  ],
  "exec": "vite build --config vite.config.chrome.ts --mode development"
}
